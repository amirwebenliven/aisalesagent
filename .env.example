# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aiagent?schema=public"
REDIS_URL="redis://localhost:6379"

# 32-byte key, hex encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts channel credentials, customer DB connection strings and BYOK keys.
# Losing this means every stored credential is unrecoverable. Back it up.
ENCRYPTION_KEY=""

# Public origin — webhooks are registered against this. Use a tunnel in dev:
#   cloudflared tunnel --url http://localhost:3000
APP_URL="http://localhost:3000"

# ── Model gateway (MeshAPI) ──────────────────────────────────────────────────
# Platform default. A tenant that supplies its own key overrides this entirely.
MESHAPI_BASE_URL="https://api.meshapi.ai/v1"
MESHAPI_KEY=""

# Two tiers. See CLAUDE.md §6 — settle these with scripts/eval-models.ts, not by argument.
MODEL_CHAT="minimax-m3"
MODEL_UTILITY="qwen3.7-flash"

# ── Channels ─────────────────────────────────────────────────────────────────
WAHA_URL="http://localhost:3001"
# Pin this. Left unset WAHA mints a fresh key on every start and prints it to
# the container log, so a restart silently 401s every WhatsApp call.
WAHA_API_KEY=""

# WAHA's own dashboard and Swagger UI at WAHA_URL — human logins, not API keys,
# and separate from WAHA_API_KEY above. docker-compose.yml requires the password
# (`:?`), so `docker compose up` fails outright without it rather than starting
# an open dashboard. Username defaults to "admin" when omitted.
WAHA_DASHBOARD_USERNAME="admin"
WAHA_DASHBOARD_PASSWORD=""

# ── Google Calendar (sensitive scopes — verification required before go-live) ─
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Safety rails (CLAUDE.md §12) ─────────────────────────────────────────────
MAX_COST_USD_PER_CONVERSATION="0.50"
MAX_COST_USD_PER_ORG_PER_DAY="25.00"
MAX_AGENT_STEPS="8"
